# Tasks for the energy-per-token example. Requires uv.

# List recipes.
default:
    @just --list

# Serve joules per token service for Orla.
energy:
    uv run uvicorn service:app --host 127.0.0.1 --port 8083

# Serve the stand-in inference backend.
backend:
    uv run uvicorn sim_backend:app --host 127.0.0.1 --port 9200

# Run the experiment
run:
    uv run uvicorn experiment.py

# Format the code with ruff.
fmt:
    uv run ruff format .

# Lint with ruff (use `just lint --fix` to apply fixes).
lint *args:
    uv run ruff check {{ args }} .

# Type-check with ty.
typecheck:
    uv run ty check .

# Read-only checks, the way CI would run them.
check:
    uv run ruff format --check .
    uv run ruff check .
    uv run ty check .
